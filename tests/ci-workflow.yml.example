# GitHub Actions workflow for the Leary behavioural tests.
#
# This file mirrors the live workflow at .github/workflows/leary-tests.yml
# (enabled 2026-11-11). It is kept next to the tests as a readable reference;
# edit the workflow itself under .github/workflows/ to change CI behaviour.

name: leary-tests

on:
  workflow_dispatch:
  push:
    paths:
      - leary.html
      - tests/**
  pull_request:
    paths:
      - leary.html
      - tests/**

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - run: node tests/leary.test.mjs
